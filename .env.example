# MarineGuard AI — Environment Configuration
# Copy this to .env and adjust values

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Model
MODEL_PATH=ml/models/trained/best.pt
MODEL_NAME=yolo11s.pt
IMAGE_SIZE=640
CONFIDENCE_THRESHOLD=0.25
DEVICE=auto

# Preprocessing
ENABLE_CLAHE=true
ENABLE_NOISE_REDUCTION=true
ENABLE_CONTRAST_ENHANCEMENT=true
RESIZE_WIDTH=640
RESIZE_HEIGHT=640

# Anomaly Scoring Weights
WEIGHT_AI_CONFIDENCE=0.50
WEIGHT_SHADOW_EVIDENCE=0.20
WEIGHT_SHAPE=0.15
WEIGHT_TEXTURE=0.10
WEIGHT_IMAGE_QUALITY=0.05

# Severity Thresholds
SEVERITY_LOW_MAX=49
SEVERITY_SUSPICIOUS_MAX=74
SEVERITY_HIGH_MAX=89

# Uploads
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=uploads
REPORT_DIR=reports

# Dataset Paths
DATASET1_PATH=datasets/forward_sonar
DATASET2_PATH=datasets/sonar_mine
